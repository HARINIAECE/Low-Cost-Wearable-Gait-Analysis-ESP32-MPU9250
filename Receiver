#include <esp_now.h>
#include <WiFi.h>

typedef struct struct_message {
  int id;

  float accX;
  float accY;
  float accZ;

  float gyroX;
  float gyroY;
  float gyroZ;

} struct_message;

struct_message incoming;

float id1_accX = 0;
float id1_accY = 0;
float id1_accZ = 0;

float id1_gyroX = 0;
float id1_gyroY = 0;

float id2_accX = 0;
float id2_accY = 0;
float id2_accZ = 0;

float id2_gyroX = 0;
float id2_gyroY = 0;

void OnDataRecv(const esp_now_recv_info *info,
                const uint8_t *data,
                int len) {

  memcpy(&incoming, data, sizeof(incoming));

  if (incoming.id == 1) {

    id1_accX = incoming.accX;
    id1_accY = incoming.accY;
    id1_accZ = incoming.accZ;

    id1_gyroX = incoming.gyroX;
    id1_gyroY = incoming.gyroY;
  }

  else if (incoming.id == 2) {

    id2_accX = incoming.accX;
    id2_accY = incoming.accY;
    id2_accZ = incoming.accZ;

    id2_gyroX = incoming.gyroX;
    id2_gyroY = incoming.gyroY;
  }
}

void setup() {

  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP NOW INIT FAILED");
    return;
  }

  esp_now_register_recv_cb(OnDataRecv);

  Serial.println("Receiver Started");
}

void loop() {

  Serial.print(id1_accX, 2);
  Serial.print(",");

  Serial.print(id1_accY, 2);
  Serial.print(",");

  Serial.print(id1_accZ, 2);
  Serial.print(",");

  Serial.print(id1_gyroX, 2);
  Serial.print(",");

  Serial.print(id1_gyroY, 2);
  Serial.print(",");

  Serial.print(id2_accX, 2);
  Serial.print(",");

  Serial.print(id2_accY, 2);
  Serial.print(",");

  Serial.print(id2_accZ, 2);
  Serial.print(",");

  Serial.print(id2_gyroX, 2);
  Serial.print(",");

  Serial.println(id2_gyroY, 2);

  delay(10);
}
